rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().size() >= 3 && data.keys().size() <= 6 &&
             data.uid == request.auth.uid &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt == request.time &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('language' in data) || (data.language in ['EN', 'HI', 'KA'])) &&
             (!('location' in data) || (data.location is map));
    }

    function isValidQuizResult(data) {
      return data.keys().hasAll(['userId', 'score', 'total', 'timestamp']) &&
             data.keys().size() == 4 &&
             data.userId == request.auth.uid &&
             data.score is int && data.score >= 0 &&
             data.total is int && data.total > 0 &&
             data.timestamp == request.time;
    }

    // --- Match Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'language', 'location']);
    }

    match /quiz_results/{resultId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidQuizResult(incoming()) && 
                    exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
  }
}
